# Copy this file to .env and adjust values for your environment.

# Project cache DB — the viz app's local cache (host port of project container).
# eventhistory here is only a cache; clear-cache truncates it safely.
DCSVIZ_DB=postgresql://dcs:dcs@localhost:5433/dcs

# Datasource archive API (2-container architecture): the datasource container
# serves /archive/* here; the project hydrates its cache from it.
DCSVIZ_ARCHIVE=http://datasource:9000   # inside compose; use localhost:9000 from host

# Datasource DB (host port of datasource container) — ingest target for HLT CSVs.
DCSVIZ_SRC_DB=postgresql://dcs:dcs@localhost:5434/dcs

# Data source: "http" (2-container, default), "hlt" (direct DB, legacy), or "simulator"
DATA_SOURCE=http
