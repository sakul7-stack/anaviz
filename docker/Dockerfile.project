# anaviz PROJECT image — the dataset-independent viz app only.
# This image contains ZERO HLT code: no datasource/ directory at all.
# It reads dataset configs from configs/ and hydrates a generic cache.
FROM timescale/timescaledb:latest-pg16

RUN apk update \
 && apk add --no-cache python3 py3-pip curl bash \
 && rm -rf /var/cache/apk/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY server ./server
COPY frontend ./frontend
COPY configs ./configs
RUN pip install --no-cache-dir . \
 || pip install --break-system-packages --no-cache-dir .

COPY docker/entrypoint.sh /usr/local/bin/anaviz-entrypoint
RUN chmod +x /usr/local/bin/anaviz-entrypoint

ENV PATH="/usr/local/bin:${PATH}"
ENTRYPOINT ["/usr/local/bin/anaviz-entrypoint"]
EXPOSE 8000
